{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "서울디지텍고등학교 시간표 조회 API",
        "title": "Digitech Hub Timetable API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "url": "http://www.swagger.io/support",
            "email": "support@swagger.io"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0"
    },
    "host": "localhost:3002",
    "basePath": "/api",
    "paths": {
        "/api/timetables/day": {
            "get": {
                "description": "특정 요일의 시간표를 조회합니다",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Timetable"
                ],
                "summary": "특정 요일 시간표 조회",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "학년 (1-3)",
                        "name": "grade",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "반 (1-20)",
                        "name": "class",
                        "in": "query",
                        "required": true
                    },
                    {
                        "enum": [
                            "MONDAY",
                            "TUESDAY",
                            "WEDNESDAY",
                            "THURSDAY",
                            "FRIDAY",
                            "SATURDAY",
                            "SUNDAY"
                        ],
                        "type": "string",
                        "description": "요일",
                        "name": "day",
                        "in": "query",
                        "required": true
                    },
                    {
                        "enum": [
                            "FIRST",
                            "SECOND"
                        ],
                        "type": "string",
                        "description": "학기",
                        "name": "semester",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 2025,
                        "description": "학년도",
                        "name": "year",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/presenter.APIResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/presenter.APIResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/presenter.APIResponse"
                        }
                    }
                }
            }
        },
        "/api/timetables/health": {
            "get": {
                "description": "서비스 상태 확인",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Health Check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/presenter.APIResponse"
                        }
                    }
                }
            }
        },
        "/api/timetables/today": {
            "get": {
                "description": "오늘의 시간표를 조회합니다",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Timetable"
                ],
                "summary": "오늘 시간표 조회",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "학년 (1-3)",
                        "name": "grade",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "반 (1-20)",
                        "name": "class",
                        "in": "query",
                        "required": true
                    },
                    {
                        "enum": [
                            "FIRST",
                            "SECOND"
                        ],
                        "type": "string",
                        "description": "학기",
                        "name": "semester",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 2025,
                        "description": "학년도",
                        "name": "year",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/presenter.APIResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/presenter.APIResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/presenter.APIResponse"
                        }
                    }
                }
            }
        },
        "/api/timetables/week": {
            "get": {
                "description": "현재 주의 시간표를 조회합니다",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Timetable"
                ],
                "summary": "주간 시간표 조회",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "학년 (1-3)",
                        "name": "grade",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "반 (1-20)",
                        "name": "class",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/presenter.APIResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/presenter.APIResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/presenter.APIResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "presenter.APIResponse": {
            "description": "API 응답 공통 구조체",
            "type": "object",
            "properties": {
                "data": {},
                "error": {
                    "type": "string"
                },
                "message": {
                    "type": "string",
                    "example": "OK"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        }
    }
